# Downloaded and prepared data stay local.
**/data/raw/*
!**/data/raw/.gitkeep
**/data/processed/*
!**/data/processed/.gitkeep

# Generated model artifacts stay local.
**/models/*
!**/models/.gitkeep
*.pkl
*.pickle
*.joblib

# Small baseline included for the first reproducible API deployment (about 12 KB).
!secondary_mushroom/models/baseline_decision_tree.joblib
!nyc_citi_bike/models/baseline_hourly_tree.joblib
!SolutionAndrew/MushroomDataset/models/random_forest.joblib
!SolutionJorre/MushroomDataset/mushroom_pipeline.joblib

# Local Python/Jupyter files and secrets.
.ipynb_checkpoints/
__pycache__/
*.py[cod]
.venv/
.venv-analysis/
.venv-aws-audit/
.venv-serving*/
venv/
.env
.env.*
!.env.example
